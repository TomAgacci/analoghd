// ============================================================================
// AHD-TV-1 Arduino Nano Firmware Suite
// 1) Multi-button illusion class selector
// 2) Serial-controlled illusion engine
// 3) Dual-pulse chromatic drift mode
// Select variant by defining FW_MODE below.
// ============================================================================

#define PIN_VSYNC_IN   2   // INT0: VSYNC from LM1881 or similar
#define PIN_OUT_LUMA   9   // OC1A: Timer1 output (luma/primary pulse)
#define PIN_OUT_CHROMA 10  // OC1B: Timer1 output (chroma/secondary pulse)

// --------------------------------------------------------------------------
// SELECT FIRMWARE MODE HERE:
// 1 = Multi-button illusion class selector
// 2 = Serial-controlled illusion engine
// 3 = Dual-pulse chroma drift mode
// --------------------------------------------------------------------------
#define FW_MODE 1

volatile bool vsyncFlag   = false;
volatile uint32_t frameId = 0;

// Illusion classes as pulse widths (µs)
const uint16_t PW_L0 = 12000;  // LDTV
const uint16_t PW_L1 = 9000;   // SD
const uint16_t PW_L2 = 6000;   // 720 illusion
const uint16_t PW_L3 = 4000;   // 1080 illusion
const uint16_t PW_L4 = 2000;   // 4K illusion
const uint16_t PW_L5 = 1000;   // 8K illusion
const uint16_t PW_L6 = 500;    // 16K–24K illusion

uint16_t currentPulse = PW_L6;

// VSYNC interrupt
void vsyncISR() {
    vsyncFlag = true;
    frameId++;
}

// Common Timer1 setup
void setupTimer1() {
    pinMode(PIN_OUT_LUMA, OUTPUT);
    pinMode(PIN_OUT_CHROMA, OUTPUT);

    // Fast PWM, TOP = ICR1, no prescaler
    TCCR1A = (1 << WGM11);
    TCCR1B = (1 << WGM13) | (1 << WGM12) | (1 << CS10);
}

// Single-pulse generator on OC1A
void generatePulseLuma(uint16_t widthMicros) {
    uint16_t ticks = (uint16_t)(widthMicros * 16);
    ICR1  = ticks;
    OCR1A = ticks / 2;

    TCCR1A |= (1 << COM1A1);
    delayMicroseconds(widthMicros);
    TCCR1A &= ~(1 << COM1A1);
}

// Dual-pulse generator: luma on OC1A, chroma on OC1B
void generateDualPulse(uint16_t widthLuma, uint16_t widthChroma, uint16_t offsetMicros) {
    uint16_t ticksL = (uint16_t)(widthLuma * 16);
    uint16_t ticksC = (uint16_t)(widthChroma * 16);

    ICR1  = max(ticksL, ticksC);
    OCR1A = ticksL / 2;
    OCR1B = ticksC / 2;

    // Enable both outputs
    TCCR1A |= (1 << COM1A1) | (1 << COM1B1);

    // Optional offset for chroma
    if (offsetMicros > 0) delayMicroseconds(offsetMicros);

    delayMicroseconds(max(widthLuma, widthChroma));

    // Disable both
    TCCR1A &= ~((1 << COM1A1) | (1 << COM1B1));
}

// --------------------------------------------------------------------------
// 1) MULTI-BUTTON ILLUSION CLASS SELECTOR
// --------------------------------------------------------------------------
#if FW_MODE == 1

// Buttons on digital pins 3–9 (example)
#define BTN_L0 3
#define BTN_L1 4
#define BTN_L2 5
#define BTN_L3 6
#define BTN_L4 7
#define BTN_L5 8
#define BTN_L6 9  // note: shares with PIN_OUT_LUMA, so move if needed

uint16_t readClassFromButtons() {
    if (digitalRead(BTN_L0) == LOW) return PW_L0;
    if (digitalRead(BTN_L1) == LOW) return PW_L1;
    if (digitalRead(BTN_L2) == LOW) return PW_L2;
    if (digitalRead(BTN_L3) == LOW) return PW_L3;
    if (digitalRead(BTN_L4) == LOW) return PW_L4;
    if (digitalRead(BTN_L5) == LOW) return PW_L5;
    if (digitalRead(BTN_L6) == LOW) return PW_L6;
    return currentPulse; // keep last if no button pressed
}

void setup() {
    pinMode(PIN_VSYNC_IN, INPUT);
    attachInterrupt(digitalPinToInterrupt(PIN_VSYNC_IN), vsyncISR, RISING);

    setupTimer1();

    pinMode(BTN_L0, INPUT_PULLUP);
    pinMode(BTN_L1, INPUT_PULLUP);
    pinMode(BTN_L2, INPUT_PULLUP);
    pinMode(BTN_L3, INPUT_PULLUP);
    pinMode(BTN_L4, INPUT_PULLUP);
    pinMode(BTN_L5, INPUT_PULLUP);
    pinMode(BTN_L6, INPUT_PULLUP);
}

void loop() {
    if (vsyncFlag) {
        vsyncFlag = false;

        currentPulse = readClassFromButtons();
        generatePulseLuma(currentPulse);
    }
}

#endif

// --------------------------------------------------------------------------
// 2) SERIAL-CONTROLLED ILLUSION ENGINE
// --------------------------------------------------------------------------
#if FW_MODE == 2

// Simple protocol: send "L0".."L6" over serial to set class
uint16_t classFromCode(char c) {
    switch (c) {
        case '0': return PW_L0;
        case '1': return PW_L1;
        case '2': return PW_L2;
        case '3': return PW_L3;
        case '4': return PW_L4;
        case '5': return PW_L5;
        case '6': return PW_L6;
        default:  return currentPulse;
    }
}

void setup() {
    pinMode(PIN_VSYNC_IN, INPUT);
    attachInterrupt(digitalPinToInterrupt(PIN_VSYNC_IN), vsyncISR, RISING);

    setupTimer1();

    Serial.begin(115200);
    Serial.println(F("AHD-TV-1 Serial Illusion Engine Ready"));
    Serial.println(F("Send 0..6 to select illusion class L0..L6"));
}

void loop() {
    if (Serial.available()) {
        char c = Serial.read();
        currentPulse = classFromCode(c);
        Serial.print(F("Class set to L"));
        Serial.println(c);
    }

    if (vsyncFlag) {
        vsyncFlag = false;
        generatePulseLuma(currentPulse);
    }
}

#endif

// --------------------------------------------------------------------------
// 3) DUAL-PULSE CHROMA DRIFT MODE
// --------------------------------------------------------------------------
#if FW_MODE == 3

// Luma pulse fixed; chroma pulse phase/drift changes over frames
const uint16_t LUMA_BASE    = PW_L3;   // 1080 illusion
const uint16_t CHROMA_WIDTH = 1000;    // chroma pulse width (µs)

void setup() {
    pinMode(PIN_VSYNC_IN, INPUT);
    attachInterrupt(digitalPinToInterrupt(PIN_VSYNC_IN), vsyncISR, RISING);

    setupTimer1();
}

void loop() {
    if (vsyncFlag) {
        vsyncFlag = false;

        // Drift chroma offset over 4 phases
        uint8_t phase = frameId % 4;
        uint16_t offset = phase * 500; // 0, 500, 1000, 1500 µs

        generateDualPulse(LUMA_BASE, CHROMA_WIDTH, offset);
    }
}

#endif
