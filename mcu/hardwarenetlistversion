; =====================================================================
; AHD-TV-1 ANALOG ENGINE HARDWARE NETLIST (CONCEPTUAL)
; =====================================================================

; POWER
VCC      +5V
GND      0

; MASTER OSCILLATOR
Q1       NPN  (CRYSTAL_OSC_OUT, CRYSTAL_NODE, GND)
XTAL1    CRYSTAL_NODE, GND   3.579545 MHz

; DIVIDER CHAIN (FRAME / FIELD / PHASE)
Q2       NPN  (DIV1_OUT, CRYSTAL_OSC_OUT, GND)
Q3       NPN  (DIV2_OUT, DIV1_OUT, GND)
Q4       NPN  (DIV3_OUT, DIV2_OUT, GND)
Q5       NPN  (DIV4_OUT, DIV3_OUT, GND)

NODE_FR_30    DIVx_TAP_30Hz
NODE_FR_100   DIVx_TAP_100Hz
NODE_FR_1000  DIVx_TAP_1000Hz
NODE_FIELD    DIVx_TAP_FIELD
NODE_PHASE    DIVx_TAP_15kHz

; MODE SELECTOR (FRAME RATE)
QM1      NPN  (FRAME_CLK_OUT, NODE_FR_30, MODE_SEL0_1)
QM2      NPN  (FRAME_CLK_OUT, NODE_FR_100, MODE_SEL0_2)
QM3      NPN  (FRAME_CLK_OUT, NODE_FR_1000, MODE_SEL0_3)

; CLASS SELECTOR (PULSE WIDTH / PHASE NETWORKS)
QC0      NPN  (PULSE_CTRL_OUT, PW_L0_NODE, CLASS_SEL0)
QC1      NPN  (PULSE_CTRL_OUT, PW_L1_NODE, CLASS_SEL1)
QC2      NPN  (PULSE_CTRL_OUT, PW_L2_NODE, CLASS_SEL2)
QC3      NPN  (PULSE_CTRL_OUT, PW_L3_NODE, CLASS_SEL3)
QC4      NPN  (PULSE_CTRL_OUT, PW_L4_NODE, CLASS_SEL4)
QC5      NPN  (PULSE_CTRL_OUT, PW_L5_NODE, CLASS_SEL5)
QC6      NPN  (PULSE_CTRL_OUT, PW_L6_NODE, CLASS_SEL6)

; PROFILE SELECTOR (ENVELOPE NETWORKS)
QP0      NPN  (LUMA_ENV_IN, ENV_BREATHING_NODE, PROFILE_SEL0)
QP1      NPN  (LUMA_ENV_IN, ENV_DRIFT_NODE, PROFILE_SEL1)
QP2      NPN  (LUMA_ENV_IN, ENV_GHOSTWAVE_NODE, PROFILE_SEL2)
QP3      NPN  (LUMA_ENV_IN, ENV_WHITEOUT_NODE, PROFILE_SEL3)

; ENVELOPE NETWORKS (RC)
R_BREATH1 ENV_BREATHING_NODE, GND   100k
C_BREATH1 ENV_BREATHING_NODE, GND   10uF

R_DRIFT1  ENV_DRIFT_NODE, GND       100k
C_DRIFT1  ENV_DRIFT_NODE, GND       10uF

R_GW1     ENV_GHOSTWAVE_NODE, GND   47k
C_GW1     ENV_GHOSTWAVE_NODE, GND   4.7uF

R_WO1     ENV_WHITEOUT_NODE, GND    10k
C_WO1     ENV_WHITEOUT_NODE, GND    1uF

; DOT DRIVER
QD1      NPN  (DOT_OUT, LUMA_ENV_IN, GND)
R_DOT    DOT_OUT, CRT_VIDEO_IN      1k

; MCU INTERFACE
MCU_PIN_FIELD_SYNC   -> NODE_FIELD (via resistor / buffer)
MCU_PIN_MODE_0       -> MODE_SEL0_1 / MODE_SEL0_2 / MODE_SEL0_3 decode
MCU_PIN_MODE_1       -> MODE_SEL0_1 / MODE_SEL0_2 / MODE_SEL0_3 decode
MCU_PIN_CLASS_0..2   -> CLASS_SEL0..6 decode
MCU_PIN_PROFILE_0..1 -> PROFILE_SEL0..3 decode

; CRT CONNECTION
CRT_VIDEO_IN         -> DOT_OUT
CRT_GND              -> GND
CRT_POWER            -> external

; =====================================================================
; END NETLIST
; =====================================================================
